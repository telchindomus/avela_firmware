# The piccolo skin's entry in the "Skin" choice (avela_ui/Kconfig) and the two values main's build reads from it.
choice AVELA_SKIN
    config AVELA_SKIN_PICCOLO
        bool "Avela piccolo (1.9 inch, deep teal, Manrope)"
endchoice

config AVELA_SKIN_COMPONENT
    default "avela_skin_piccolo" if AVELA_SKIN_PICCOLO

# the firmware version whose skin API this skin implements (docs/developer/SKINS.md: Compatibility); an official
# skin's is always the project version (tools/check_skin_api.sh)
config AVELA_SKIN_API_VERSION
    default "0.1.0" if AVELA_SKIN_PICCOLO
