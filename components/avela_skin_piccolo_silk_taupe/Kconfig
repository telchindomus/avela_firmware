# The Silk Taupe skin's entry in the "Skin" choice (avela_ui/Kconfig) and the two values main's build reads from it.
choice AVELA_SKIN
    config AVELA_SKIN_PICCOLO_SILK_TAUPE
        bool "Avela piccolo Silk Taupe (1.9 inch, taupe and champagne gold, Manrope)"
endchoice

config AVELA_SKIN_COMPONENT
    default "avela_skin_piccolo_silk_taupe" if AVELA_SKIN_PICCOLO_SILK_TAUPE

# the firmware version whose skin API this skin implements (docs/developer/SKINS.md: Compatibility); an official
# skin's is always the project version (tools/check_skin_api.sh)
config AVELA_SKIN_API_VERSION
    default "1.0.1" if AVELA_SKIN_PICCOLO_SILK_TAUPE
