# Copy to cicd/.env (git-ignored) and adjust. Everything here has a default.
# Where the scripts work (default: cicd/build in the repository).
BUILD_DIR=/srv/avela-firmware-cicd
# build.sh's output (default: $BUILD_DIR/artifacts).
ARTIFACTS_DIR=/srv/avela-firmware-cicd/artifacts
# The fresh clones that build.sh and test_unit.sh build in (default: $BUILD_DIR/clones).
CLONES_DIR=/srv/avela-firmware-cicd/clones
# The repository build.sh and test_unit.sh clone (default: the origin remote).
REPO_URL=https://github.com/<owner>/avela_firmware.git
# What build.sh builds without --tag/--version (default: main).
BUILD_BRANCH=main
